# Copy this file to .env and change what you need. .env is never committed.

# Which environment to test. "production" (the live Vercel app) or "local"
# (the app served from ../Practice-App with: python -m http.server 8000).
TEST_ENV=production

# A full base URL. When this is set it wins over TEST_ENV, so you can point
# the whole suite at a preview deployment without touching any code.
# BASE_URL=https://practiceapp-six.vercel.app
