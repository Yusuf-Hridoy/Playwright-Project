# Playwright Test Command Center — environment variables (Phase 1)
#
# Copy this file to .env and fill in real values. Variables are used for
# scheduled-run email alerts in a later phase.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com
ALERT_EMAIL=alerts@example.com
